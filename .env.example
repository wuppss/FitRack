# ExerciseDB (RapidAPI) credentials.
# Copy this file to `.env.local` and paste your key. `.env.local` is gitignored,
# so your key is never committed. You can also paste the key directly in the app
# (Profile → Exercise Library → API key), which stores it in your browser only.
VITE_RAPIDAPI_KEY=
VITE_RAPIDAPI_HOST=exercisedb.p.rapidapi.com
